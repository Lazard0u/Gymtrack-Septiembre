# Plantilla local: copiala como .env y reemplazá los valores necesarios.
# Nunca confirmes secretos reales ni reutilices estas credenciales de ejemplo.
APP_ENV=development
APP_KEY=generate-a-long-random-value
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:8080

MYSQL_ROOT_PASSWORD=change-me
DB_DATABASE=gymtrack
DB_USERNAME=gymtrack_user
DB_PASSWORD=change-me

SESSION_NAME=gymtrack_session
SESSION_SECURE=false
SESSION_PATH=/
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800

TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_TURNSTILE_ENABLED=false

# Desarrollo/demo puede usar log. Producción debe usar mail con MAIL_FROM válido.
MAIL_TRANSPORT=log
MAIL_FROM=no-reply@gymtrack.local
MAIL_FROM_NAME=GymTrack
MAIL_LOG_PATH=/tmp/gymtrack-mail/mail.log
# Para Gmail: smtp.gmail.com, puerto 587 y cifrado tls.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
EMAIL_VERIFICATION_TTL_SECONDS=86400
UPLOAD_STORAGE_PATH=/var/lib/gymtrack/uploads

# Sólo para ejecutar manualmente backend/seed_admin.php
ADMIN_EMAIL=

# Pagos. Las credenciales reales nunca se guardan en el repositorio.
PAYMENT_PROVIDER=mercado_pago
PAYMENT_MODE=test
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
ADMIN_INITIAL_PASSWORD=
ADMIN_NAME=Administrador GymTrack

# Dataset para presentaciones. Nunca se ejecuta automáticamente.
SEED_DEMO_DATA=false
DEMO_DATASET_NAME=gymtrack-presentation
DEMO_USER_PASSWORD=
ALLOW_DEMO_DATA_IN_PRODUCTION=false

# Módulos secundarios: ocultos mientras la flag sea false.
FEATURE_WHATSAPP=false
FEATURE_GOOGLE_CALENDAR_SYNC=false
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_PERSONAL_RECOMMENDATIONS=false

# Geocodificación iniciada manualmente desde Administración. Para producción,
# usá un contacto real en el User-Agent o configurá un proveedor propio.
GEOCODING_ENABLED=true
GEOCODING_PROVIDER_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT="GymTrack/1.0 (contacto@gymtrack.local)"
GEOCODING_CACHE_DAYS=30

# Grafana (solo desarrollo): contraseña del admin de Grafana.
GRAFANA_ADMIN_PASSWORD=
# Contraseña del usuario MySQL grafana_ro (la crea scripts/grafana-readonly-user.sh).
GRAFANA_DB_PASSWORD=
