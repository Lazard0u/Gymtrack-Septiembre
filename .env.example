APP_ENV=development
APP_KEY=generate-a-long-random-value
FRONTEND_URL=http://localhost:5173

MYSQL_ROOT_PASSWORD=change-me
DB_DATABASE=gymtrack
DB_USERNAME=gymtrack_user
DB_PASSWORD=change-me

SESSION_NAME=gymtrack_session
SESSION_SECURE=false
SESSION_PATH=/
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800

TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_TURNSTILE_ENABLED=false

# Desarrollo/demo puede usar log. Producción debe usar mail con MAIL_FROM válido.
MAIL_TRANSPORT=log
MAIL_FROM=no-reply@gymtrack.local
MAIL_LOG_PATH=/tmp/gymtrack-mail/mail.log
UPLOAD_STORAGE_PATH=/var/lib/gymtrack/uploads

# Sólo para ejecutar manualmente backend/seed_admin.php
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
ADMIN_NAME=Administrador GymTrack

# Dataset para presentaciones. Nunca se ejecuta automáticamente.
SEED_DEMO_DATA=false
DEMO_DATASET_NAME=gymtrack-presentation
DEMO_USER_PASSWORD=
ALLOW_DEMO_DATA_IN_PRODUCTION=false

# Módulos secundarios: ocultos mientras la flag sea false.
FEATURE_WHATSAPP=false
FEATURE_GOOGLE_CALENDAR_SYNC=false
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_PERSONAL_RECOMMENDATIONS=false
FEATURE_PROMOTIONS_BETA=false
