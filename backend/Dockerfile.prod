# Composer resuelve exactamente las versiones registradas en composer.lock.
FROM composer:2@sha256:d8f6343d3fae98107426bc49163ccad46ef85aabd4a27d80a74401fab4aba332 AS dependencias

WORKDIR /aplicacion
COPY composer.json composer.lock ./
RUN composer install --no-dev --prefer-dist --no-interaction --no-progress --optimize-autoloader

# Imagen de producción de la API: PHP/Apache, extensiones y cliente de correo.
# Las capas se mantienen deterministas para obtener builds reproducibles.
FROM php:8.2-apache@sha256:7e06895d44c29647db123c1b6410dbd7765ccbdd36054b941325ce59a486397b

ARG APP_REVISION=unknown

LABEL org.opencontainers.image.title="GymTrack API" \
      org.opencontainers.image.description="Backend PHP de GymTrack" \
      org.opencontainers.image.revision="${APP_REVISION}"

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates libonig-dev msmtp-mta \
    && docker-php-ext-install -j"$(nproc)" mbstring pdo_mysql opcache \
    && a2enmod rewrite headers expires \
    && rm -rf /var/lib/apt/lists/*

RUN install -d -o www-data -g www-data -m 0750 /var/lib/gymtrack/uploads \
    && install -d -o www-data -g www-data -m 0700 /var/lib/php/sessions \
    && { \
        echo 'ServerName localhost'; \
        echo 'ServerTokens Prod'; \
        echo 'ServerSignature Off'; \
        echo 'TraceEnable Off'; \
    } > /etc/apache2/conf-available/gymtrack-security.conf \
    && a2enconf gymtrack-security \
    && { \
        echo 'expose_php=Off'; \
        echo 'display_errors=Off'; \
        echo 'display_startup_errors=Off'; \
        echo 'log_errors=On'; \
        echo 'error_reporting=E_ALL'; \
        echo 'memory_limit=256M'; \
        echo 'max_execution_time=30'; \
        echo 'max_input_time=30'; \
        echo 'upload_max_filesize=5M'; \
        echo 'post_max_size=6M'; \
        echo 'session.use_only_cookies=1'; \
        echo 'session.use_strict_mode=1'; \
        echo 'session.use_trans_sid=0'; \
        echo 'session.cookie_httponly=1'; \
        echo 'session.cookie_secure=1'; \
        echo 'session.cookie_samesite=Lax'; \
        echo 'session.save_path=/var/lib/php/sessions'; \
        echo 'session.gc_maxlifetime=28800'; \
        echo 'session.gc_probability=1'; \
        echo 'session.gc_divisor=1000'; \
        echo 'opcache.enable=1'; \
        echo 'opcache.validate_timestamps=0'; \
        echo 'opcache.memory_consumption=128'; \
        echo 'opcache.max_accelerated_files=10000'; \
        echo 'sendmail_path="/usr/bin/msmtp --file=/run/secrets/smtp_config -t"'; \
    } > "${PHP_INI_DIR}/conf.d/zz-gymtrack-production.ini"

WORKDIR /var/www/html

COPY --chown=www-data:www-data . /var/www/html
COPY --from=dependencias --chown=www-data:www-data /aplicacion/vendor /var/www/html/vendor

RUN find /var/www/html -type d -exec chmod 0755 {} + \
    && find /var/www/html -type f -exec chmod 0644 {} + \
    && php -r 'require "/var/www/html/vendor/autoload.php"; if (!class_exists("PHPMailer\\PHPMailer\\PHPMailer")) { fwrite(STDERR, "PHPMailer no está disponible.\n"); exit(1); } foreach (["mbstring","curl","fileinfo","pdo_mysql","Zend OPcache"] as $extension) { if (!extension_loaded($extension)) { fwrite(STDERR, "Missing PHP extension: {$extension}\n"); exit(1); } }' \
    && apache2ctl -t

EXPOSE 80
