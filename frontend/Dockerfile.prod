# Node compila Vue y Nginx recibe sólo los archivos estáticos resultantes;
# las herramientas de desarrollo no llegan a la imagen final.
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

ARG TURNSTILE_PUBLIC_SITE_ID

RUN test -n "${TURNSTILE_PUBLIC_SITE_ID}" \
    && VITE_TURNSTILE_ENABLED=true \
       VITE_TURNSTILE_SITE_KEY="${TURNSTILE_PUBLIC_SITE_ID}" \
       npm run build

FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10

LABEL org.opencontainers.image.title="GymTrack web" \
      org.opencontainers.image.description="Frontend Vue 3 de GymTrack"

COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
