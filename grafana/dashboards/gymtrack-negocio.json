    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value"
   }
  },
  {
   "id": 3,
   "title": "Ocupación media de sesiones",
   "type": "stat",
   "datasource": {
    "type": "mysql",
    "uid": "gymtrack-mysql"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mysql",
      "uid": "gymtrack-mysql"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT COALESCE(SUM(cupos_reservados)/NULLIF(SUM(cupo_maximo),0),0) AS ocupacion FROM sesiones_clase WHERE estado<>'cancelada' AND $__timeFilter(inicio_en) AND gimnasio_id IN ($gym)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value"
   }
  },
  {
   "id": 4,
   "title": "Asistencia (presentes / reservas cerradas)",
   "type": "stat",
   "datasource": {
    "type": "mysql",
    "uid": "gymtrack-mysql"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mysql",
      "uid": "gymtrack-mysql"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT COALESCE(SUM(r.estado='asistio')/NULLIF(SUM(r.estado IN ('asistio','no_asistio')),0),0) AS asistencia FROM reservas r JOIN sesiones_clase s ON s.id=r.sesion_clase_id WHERE $__timeFilter(s.inicio_en) AND s.gimnasio_id IN ($gym)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value"
   }
  },
  {
   "id": 5,
   "title": "Ingresos por día",
   "type": "timeseries",
   "datasource": {
    "type": "mysql",
    "uid": "gymtrack-mysql"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mysql",
      "uid": "gymtrack-mysql"
     },
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT DATE(fecha_pago) AS time, SUM(monto) AS ingresos FROM pagos WHERE estado='aprobado' AND $__timeFilter(fecha_pago) AND gimnasio_id IN ($gym) GROUP BY 1 ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUYU"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 6,
   "title": "Reservas por día",
   "type": "timeseries",
   "datasource": {
    "type": "mysql",
    "uid": "gymtrack-mysql"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mysql",
      "uid": "gymtrack-mysql"
     },
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT DATE(r.fecha_reserva) AS time, COUNT(*) AS reservas FROM reservas r JOIN sesiones_clase s ON s.id=r.sesion_clase_id WHERE $__timeFilter(r.fecha_reserva) AND s.gimnasio_id IN ($gym) GROUP BY 1 ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 7,
   "title": "Ocupación por clase",
   "type": "barchart",
   "datasource": {
    "type": "mysql",
    "uid": "gymtrack-mysql"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mysql",
      "uid": "gymtrack-mysql"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT c.nombre AS clase, SUM(s.cupos_reservados)/NULLIF(SUM(s.cupo_maximo),0) AS ocupacion FROM sesiones_clase s JOIN clases c ON c.id=s.clase_id WHERE s.estado<>'cancelada' AND $__timeFilter(s.inicio_en) AND s.gimnasio_id IN ($gym) GROUP BY c.id,c.nombre ORDER BY ocupacion DESC"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "legend": {
     "showLegend": false
    }
   }
  },
