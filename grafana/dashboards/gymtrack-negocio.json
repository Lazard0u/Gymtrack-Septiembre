  {
   "id": 10,
   "title": "Membresías que vencen en 14 días",
   "type": "table",
   "datasource": {
    "type": "mysql",
    "uid": "gymtrack-mysql"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mysql",
      "uid": "gymtrack-mysql"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT numero_socio AS socio, plan, fecha_vencimiento AS vence FROM membresias WHERE estado='activa' AND fecha_vencimiento BETWEEN CURDATE() AND DATE_ADD(CURDATE(), INTERVAL 14 DAY) AND gimnasio_id IN ($gym) ORDER BY fecha_vencimiento"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
