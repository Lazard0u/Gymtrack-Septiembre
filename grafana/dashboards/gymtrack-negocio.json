    "label": "Gimnasio",
    "type": "query",
    "datasource": {
     "type": "mysql",
     "uid": "gymtrack-mysql"
    },
    "query": "SELECT id AS __value, nombre AS __text FROM gimnasios ORDER BY nombre",
    "refresh": 1,
    "multi": true,
    "includeAll": true,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "title": "Socios con membresía activa",
   "type": "stat",
   "datasource": {
    "type": "mysql",
    "uid": "gymtrack-mysql"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mysql",
      "uid": "gymtrack-mysql"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT COUNT(DISTINCT usuario_id) AS socios FROM membresias WHERE estado='activa' AND gimnasio_id IN ($gym)"
    }
