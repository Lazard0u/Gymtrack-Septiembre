  {
   "id": 11,
   "title": "Ingresos por plan",
   "type": "barchart",
   "datasource": {
    "type": "mysql",
    "uid": "gymtrack-mysql"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mysql",
      "uid": "gymtrack-mysql"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT pm.nombre AS plan, SUM(p.monto) AS ingresos FROM pagos p JOIN membresias m ON m.id=p.membresia_id LEFT JOIN planes_membresia pm ON pm.id=m.plan_id WHERE p.estado='aprobado' AND $__timeFilter(p.fecha_pago) AND p.gimnasio_id IN ($gym) GROUP BY pm.id,pm.nombre ORDER BY 2 DESC"
    }
   ],
   "fieldConfig": {
