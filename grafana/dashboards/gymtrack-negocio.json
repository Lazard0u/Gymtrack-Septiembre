  {
   "id": 2,
   "title": "Ingresos aprobados (período)",
   "type": "stat",
   "datasource": {
    "type": "mysql",
    "uid": "gymtrack-mysql"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mysql",
      "uid": "gymtrack-mysql"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT COALESCE(SUM(monto),0) AS ingresos FROM pagos WHERE estado='aprobado' AND $__timeFilter(fecha_pago) AND gimnasio_id IN ($gym)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUYU"
